# Copy to .env and fill in. Never commit .env.

# --- Modes: mock = fake data, live = real systems. NETSUITE_MODE / RL_MODE override APP_MODE.
APP_MODE=mock
# NETSUITE_MODE=mock
# RL_MODE=live
# RL_BASE_URL=https://api.rlc.com        # https://apisandbox.rlc.com for R+L's sandbox

# --- Sign-in. hub = Acme hub handles login (container must ONLY be reachable through the hub).
AUTH_MODE=hub
# TRUSTED_USER_HEADER=X-Forwarded-User   # header the hub uses to pass the signed-in user's name
# ALLOWED_FRAME_ANCESTORS=self https://hub-dev.example.com https://hub.example.com   (write self without quotes)
# AUTH_MODE=password  needs: SITE_PASSWORD=...  SESSION_SECRET=(40+ random characters)

# --- R+L
RL_API_KEY=

# --- NetSuite (token-based auth; comes last)
NS_ACCOUNT_ID=
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=

# --- Options
# QUOTE_VALID_HOURS=24
# RETENTION_DAYS=365
# CLASS_TOOL_URL=https://www.freightclasscalc.com/calculator.php
# PORT=8080
